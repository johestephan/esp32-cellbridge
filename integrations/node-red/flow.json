[
  {
    "id": "a7670e_tab",
    "type": "tab",
    "label": "ESP32 CellBridge",
    "disabled": false,
    "info": "Example Node-Red flow for receiving SMS/Call webhooks and sending SMS via REST API."
  },
  {
    "id": "wh_in",
    "type": "http in",
    "z": "a7670e_tab",
    "name": "Gateway Webhook",
    "url": "/a7670e-webhook",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 150,
    "y": 120,
    "wires": [["wh_resp", "wh_switch"]]
  },
  {
    "id": "wh_resp",
    "type": "http response",
    "z": "a7670e_tab",
    "name": "200 OK",
    "statusCode": "200",
    "headers": {},
    "x": 360,
    "y": 80,
    "wires": []
  },
  {
    "id": "wh_switch",
    "type": "switch",
    "z": "a7670e_tab",
    "name": "Route Event",
    "property": "payload.event",
    "propertyType": "msg",
    "rules": [
      { "t": "eq", "v": "sms.received", "vt": "str" },
      { "t": "eq", "v": "call.incoming", "vt": "str" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 370,
    "y": 140,
    "wires": [["dbg_sms"], ["dbg_call"]]
  },
  {
    "id": "dbg_sms",
    "type": "debug",
    "z": "a7670e_tab",
    "name": "Incoming SMS",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload.data",
    "targetType": "msg",
    "x": 580,
    "y": 120,
    "wires": []
  },
  {
    "id": "dbg_call",
    "type": "debug",
    "z": "a7670e_tab",
    "name": "Incoming Call",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload.data",
    "targetType": "msg",
    "x": 580,
    "y": 180,
    "wires": []
  },
  {
    "id": "inj_send",
    "type": "inject",
    "z": "a7670e_tab",
    "name": "Test Send SMS",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"to\":\"+31612345678\",\"message\":\"Hello from Node-Red!\"}",
    "payloadType": "json",
    "x": 140,
    "y": 280,
    "wires": [["prep_headers"]]
  },
  {
    "id": "prep_headers",
    "type": "function",
    "z": "a7670e_tab",
    "name": "Set API Key Header",
    "func": "msg.headers = {\n  \"Content-Type\": \"application/json\",\n  \"X-API-Key\": \"CHANGE_ME_API_KEY\"\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 350,
    "y": 280,
    "wires": [["http_send_sms"]]
  },
  {
    "id": "http_send_sms",
    "type": "http request",
    "z": "a7670e_tab",
    "name": "POST /api/sms/send",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://esp32-cellbridge.local/api/sms/send",
    "tls": "",
    "persist": false,
    "proxy": "",
    "x": 580,
    "y": 280,
    "wires": [["dbg_send"]]
  },
  {
    "id": "dbg_send",
    "type": "debug",
    "z": "a7670e_tab",
    "name": "Send Result",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 790,
    "y": 280,
    "wires": []
  }
]
